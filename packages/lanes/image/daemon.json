{
  "default-runtime": "nokeyring",
  "runtimes": {
    "nokeyring": {
      "runtimeType": "io.containerd.runc.v2",
      "options": { "NoNewKeyring": true }
    }
  },
  "builder": {
    "gc": {
      "enabled": true,
      "defaultReservedSpace": "256MB",
      "defaultMaxUsedSpace": "512MB",
      "defaultMinFreeSpace": "1GB"
    }
  }
}

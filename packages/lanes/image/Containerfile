# pinetrie's default lane image: the tools every lane can count on.
# - Debian trixie and Node 24.
# - git 2.47: jj needs 2.41 or later.
# - pnpm, through corepack.
# - python3.
# - Static musl builds of jj (pinned to the host's version), rg, fd and sd,
#   for the machine the image is built on, aarch64 or x86_64 (`uname -m`
#   in the build, which needs no BuildKit). The lane runtime copies them out
#   of this image, so every lane has them whatever its image (`runtime.ts`).
#   Debian's own rg and fd link glibc, and would not run on a musl image.
# - Chromium's headless shell and its libraries, at the build pinetrie's
#   Playwright drives (`PLAYWRIGHT_VERSION`).
# - Rootless Docker, the docker CLI and buildx, for a lane granted lanes of
#   its own (`lanes.nested`); unused otherwise.
# A project's own `pinetrie.Containerfile` replaces it. The lane runtime is
# copied out of this image (`runtime.ts`).
FROM docker.io/library/node:24-trixie-slim
ARG JJ_VERSION
ARG RG_VERSION=15.2.0
ARG FD_VERSION=10.5.0
ARG SD_VERSION=1.1.0
# ssh reads the host's generated config from `/pinetrie-ssh`, where a lane
# holding an identity mounts it; a missing Include is skipped without a word.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends git ca-certificates curl procps python3 openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && printf 'Include /pinetrie-ssh/config\n' > /etc/ssh/ssh_config.d/10-pinetrie.conf \
 && arch=$(uname -m) \
 && case "$arch" in aarch64|x86_64) ;; *) echo "no release builds for $arch" >&2; exit 1 ;; esac \
 && curl -fsSL "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/jj-v${JJ_VERSION}-${arch}-unknown-linux-musl.tar.gz" \
    | tar -xz -C /usr/local/bin ./jj \
 && musl() { curl -fsSL "https://github.com/$1/releases/download/$2/$3-${arch}-unknown-linux-musl.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 "$3-${arch}-unknown-linux-musl/$4"; } \
 && musl BurntSushi/ripgrep "${RG_VERSION}" "ripgrep-${RG_VERSION}" rg \
 && musl sharkdp/fd "v${FD_VERSION}" "fd-v${FD_VERSION}" fd \
 && musl chmln/sd "v${SD_VERSION}" "sd-v${SD_VERSION}" sd \
 && corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ARG PLAYWRIGHT_VERSION
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx -y "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium-headless-shell \
 && rm -rf /var/lib/apt/lists/* /root/.npm
# Lanes inside a lane: rootless Docker, from Docker's static
# bundles, which a lane granted `lanes.nested` starts as `rootless` (uid 1000)
# on its data root, a btrfs subvolume of its own (`pinetrie-inner-docker`).
# Its daemon.json, copied in from beside this file, makes runc's NoNewKeyring
# its default (Docker's seccomp profile refuses `keyctl`), and caps BuildKit's
# cache beside its images: the defaults are fractions of the lane VM's whole
# disk, which no lane's cache would reach.
# BuildKit starts runc itself, not through that default, so `runc` in
# /usr/local/sbin, first on the inner Docker's PATH, adds --no-new-keyring. The
# docker CLI and buildx are for a pine·trie host running in the lane.
# newuidmap and newgidmap carry file capabilities, not setuid: setuid root,
# they open uid_map as root, and writing it needs CAP_SYS_ADMIN over the new
# namespace, which a lane lacks; as its owner (uid 1000) with CAP_SETUID they
# may write it. rootlesskit makes slirp4netns's tap device with `ip`,
# and the inner Docker sets sysctls with `sysctl`: both in /usr/sbin, which
# its PATH has.
ARG DOCKER_VERSION=29.8.2
ARG BUILDX_VERSION=0.37.2
# Docker names the architectures as `uname -m` does; buildx as Go does.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends btrfs-progs uidmap slirp4netns iptables iproute2 libcap2-bin \
 && rm -rf /var/lib/apt/lists/* \
 && arch=$(uname -m) \
 && case "$arch" in aarch64) goarch=arm64 ;; x86_64) goarch=amd64 ;; *) echo "no release builds for $arch" >&2; exit 1 ;; esac \
 && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-${DOCKER_VERSION}.tgz" \
    | tar -xz -C /usr/local/bin --strip-components=1 \
 && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-rootless-extras-${DOCKER_VERSION}.tgz" \
    | tar -xz -C /usr/local/bin --strip-components=1 \
 && mkdir -p /usr/local/lib/docker/cli-plugins \
 && curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-buildx \
    "https://github.com/docker/buildx/releases/download/v${BUILDX_VERSION}/buildx-v${BUILDX_VERSION}.linux-${goarch}" \
 && chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx \
 && chmod u-s /usr/bin/newuidmap /usr/bin/newgidmap \
 && setcap cap_setuid+ep /usr/bin/newuidmap \
 && setcap cap_setgid+ep /usr/bin/newgidmap \
 && groupmod -n rootless node \
 && usermod -l rootless -d /home/rootless -m node \
 && echo "rootless:100000:65536" > /etc/subuid \
 && echo "rootless:100000:65536" > /etc/subgid \
 && mkdir -p /home/rootless/.config/docker \
 && chown -R rootless:rootless /home/rootless \
 && printf '%s\n' \
    '#!/bin/sh' \
    '# A nested lane'"'"'s inner Docker: rootless, as uid 1000, on its data root, a subvolume of its own in its inner lanes'"'"' disk.' \
    '[ -d /var/lib/pinetrie-lanes ] || exit 0' \
    '# /run outlives a stopped container, and this runs at each start: a pid file' \
    '# or socket of the daemon before the stop would refuse this one.' \
    'rm -rf /run/user/1000' \
    'mkdir -p /run/user/1000 && chown 1000:1000 /run/user/1000 && chmod 700 /run/user/1000' \
    'exec setpriv --reuid=1000 --regid=1000 --init-groups env HOME=/home/rootless XDG_RUNTIME_DIR=/run/user/1000 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin dockerd-rootless.sh --data-root /var/lib/pinetrie-lanes/docker > /tmp/inner-docker.log 2>&1' \
    > /usr/local/bin/pinetrie-inner-docker \
 && chmod +x /usr/local/bin/pinetrie-inner-docker \
 && printf '%s\n' \
    '#!/bin/sh' \
    '# runc for the inner Docker of a nested lane: run and create get --no-new-keyring, for the containers of BuildKit as for those of Docker.' \
    'n=$#' \
    'added=no' \
    'for a in "$@"; do' \
    '  set -- "$@" "$a"' \
    '  if [ "$added" = no ] && { [ "$a" = run ] || [ "$a" = create ]; }; then set -- "$@" --no-new-keyring; added=yes; fi' \
    'done' \
    'shift "$n"' \
    'exec /usr/local/bin/runc "$@"' \
    > /usr/local/sbin/runc \
 && chmod +x /usr/local/sbin/runc
COPY --chown=rootless:rootless daemon.json /home/rootless/.config/docker/daemon.json

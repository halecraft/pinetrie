#!/bin/sh
# PID 1 of pine·trie's lane VM (S128), on the system image stage 1 switched to.
# It loads the drivers, keeps the clock to the RTC, mounts the data disk and
# each host's slot, and starts Docker, each slot's ssh agent and a sync on
# vsock 2377. Docker is bridged
# to vsock 2375 only once the lanes' fence is set. No shell listens on any
# port. Every stage logs a `T+` line, the guest's uptime, to the console.
#
# The kernel's command line: lane.slots=<n>, the share devices `slot0` …
# `slot<n-1>` the launcher made, and lane.services_floor=<bytes>, the
# services' guaranteed floor (below).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sys /sys
mountpoint -q /dev || mount -t devtmpfs dev /dev
t() { echo "T+$(cut -d' ' -f1 /proc/uptime) $*" > /dev/hvc0; }
arg() { sed -n "s/.*$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
exec > /dev/hvc0 2>&1
t "init started"

mkdir -p /dev/pts /dev/shm /run/pinetrie /tmp /var/lib/lanehost /mnt/host-shares
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mkdir -p /run/pinetrie
mount -t tmpfs tmpfs /tmp
# memory_recursiveprot: a parent's memory.low protects the cgroups under it
# by itself, so a service needs no floor of its own.
mount -t cgroup2 -o memory_recursiveprot cgroup2 /sys/fs/cgroup
# The services' parent (lanehost's roles and the observer, which Docker puts
# under it), with their floor: the kernel reclaims the lanes' pages before
# theirs while it has any to take. A floor protects only under parents that
# have one, and Docker's own has none, so the services are apart from it.
# The host reads the floor back; one not written is said there.
services_floor=$(arg lane.services_floor)
if mkdir -p /sys/fs/cgroup/pinetrie-services &&
  echo "+memory +pids +cpu" > /sys/fs/cgroup/cgroup.subtree_control &&
  echo "+memory +pids +cpu" > /sys/fs/cgroup/pinetrie-services/cgroup.subtree_control &&
  echo "${services_floor:-0}" > /sys/fs/cgroup/pinetrie-services/memory.low; then
  t "services' floor: ${services_floor:-0} bytes"
else
  t "services' floor not set"
fi

# Every device's driver, then the manifest's modules (`build.sh` writes them
# to /etc/pinetrie/modules). Alpine's own module index: no udev here.
for f in /sys/bus/*/devices/*/modalias; do modprobe -q "$(cat "$f")" 2>/dev/null; done
modprobe -a $(cat /etc/pinetrie/modules)
# The kernel makes /dev/net/tun 0600; udev would make it 0666, which rootless
# Docker in a lane needs for its network (S127).
chmod 666 /dev/net/tun
t "drivers loaded"

# The clock, kept to the RTC (`clock`).
/usr/local/sbin/pinetrie-clock /sys/class/rtc/rtc0/since_epoch &

# The data disk: Docker's store and the lanes' subvolumes. An unprivileged
# container deletes subvolumes only with user_subvol_rm_allowed (S125).
if ! mount -t btrfs -o user_subvol_rm_allowed /dev/vdb /var/lib/lanehost 2>/dev/null; then
  mkfs.btrfs -q -f /dev/vdb && mount -t btrfs -o user_subvol_rm_allowed /dev/vdb /var/lib/lanehost
  t "data disk formatted (first boot)"
fi
# A data.img grown on the Mac (`truncate -s`) is used from this boot on.
# Before Docker: a full disk can stop dockerd starting, or let it answer and
# fail every write. A full disk's metadata can refuse the resize itself:
# why is on the console.
if ! out=$(btrfs filesystem resize max /var/lib/lanehost 2>&1); then
  t "data disk not resized: $out"
fi
# The disk's room after the resize, from btrfs's counters, and whether it
# is full: the host reads `data disk full` after each start it makes, and
# repairs the disk with the VM stopped. Full is unallocated under 1 GiB,
# the host's own threshold for spent (a test holds it to the host's), not
# metadata's share: a disk whose metadata refused every write read 91%
# used by these counters, btrfs keeping its reserve. Shell arithmetic,
# 64-bit: busybox awk's %d stops at 2^31-1.
fs=$(ls -d /sys/fs/btrfs/*-*-*-*-* 2>/dev/null | head -1)
if [ -n "$fs" ]; then
  size=$(( $(cat /sys/block/vdb/size) * 512 ))
  allocated=0
  for k in data metadata system; do
    allocated=$(( allocated + $(cat "$fs/allocation/$k/disk_total") ))
  done
  unallocated=$(( size - allocated ))
  meta_used=$(cat "$fs/allocation/metadata/bytes_used")
  meta_total=$(cat "$fs/allocation/metadata/total_bytes")
  t "data disk room: unallocated=$unallocated metadata=$meta_used/$meta_total"
  if [ "$unallocated" -lt $((1024 * 1024 * 1024)) ]; then
    t "data disk full"
  fi
fi
mkdir -p /var/lib/lanehost/docker
t "data disk mounted: $(df -h /var/lib/lanehost | awk 'NR==2 {print $3 " of " $2 " used"}')"

# Each host's slot: a share device of its own, an empty directory until its
# host fills it. A mount of a slot's root survives the slot being filled
# (S130, S131).
slots=$(arg lane.slots)
i=0
while [ "$i" -lt "${slots:-0}" ]; do
  mkdir -p "/mnt/host-shares/$i"
  mount -t virtiofs "slot$i" "/mnt/host-shares/$i" || t "slot $i not mounted"
  i=$((i + 1))
done
t "$i slots mounted"

hostname lanes
ip link set lo up
ip link set eth0 up
# The network before Docker: a pull Docker answers before DHCP has written
# /etc/resolv.conf asks [::1]:53 and fails. With no answer in 10 s, Docker
# starts anyway, for what it holds.
if udhcpc -i eth0 -q -f -n -t 10 -T 1 >/dev/null 2>&1; then
  t "network up: $(ip -4 -br addr show eth0)"
else
  t "network: no DHCP answer in 10 s; Docker starts without it"
fi

# Its daemon.json caps BuildKit's cache beside its images: the defaults are
# fractions of the data disk, and the root is read-only, so the file is the
# image's.
dockerd --host unix:///var/run/docker.sock --data-root /var/lib/lanehost/docker --config-file /etc/pinetrie/daemon.json > /run/dockerd.log 2>&1 &
# Each slot's ssh agent: a socket lanes bind, connected to the launcher's
# vsock port for that slot, which reaches its host's agent.
i=0
while [ "$i" -lt "${slots:-0}" ]; do
  socat -t 3600 "UNIX-LISTEN:/run/pinetrie/ssh-$i.sock,fork,mode=666" "VSOCK-CONNECT:2:$((2400 + i))" &
  i=$((i + 1))
done

# The launcher's sync before it stops the VM: `sync`, and nothing else, on
# vsock 2377. Only the launcher reaches it: a lane cannot open a vsock socket
# (S128).
socat VSOCK-LISTEN:2377,reuseaddr,fork SYSTEM:'sync && echo synced' &

ping_docker() { printf 'GET /_ping HTTP/1.0\r\n\r\n' | socat -t 2 - UNIX-CONNECT:/var/run/docker.sock 2>/dev/null | grep -q OK; }
until [ -S /var/run/docker.sock ] && ping_docker; do sleep 0.05; done

# The fence (S136): gvproxy's network is the gateway (192.168.127.1), whose
# port 80 is gvproxy's API, which opens ports on the Mac, and the host
# address (192.168.127.254), which is the Mac's loopback. A lane reaches the
# gateway's DNS and nothing else of it, unless a project grants a port (the
# host inserts its rules above these). In DOCKER-USER, which Docker made at
# its start and runs first for every container's traffic: a lane cannot
# change it. Lanes' traffic only: the VM's own (pulls) is not forwarded.
fence() {
  i=0
  until iptables -L DOCKER-USER -n >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 100 ] || return 1
    sleep 0.05
  done
  iptables -I DOCKER-USER -d 192.168.127.0/24 -j REJECT &&
    iptables -I DOCKER-USER -d 192.168.127.1 -p tcp --dport 53 -j RETURN &&
    iptables -I DOCKER-USER -d 192.168.127.1 -p udp --dport 53 -j RETURN
}
if ! fence; then
  # Docker stays out of the Mac's reach: no host's lease gets an answer.
  t "the lanes' fence could not be set: Docker is not bridged to the Mac"
  while :; do sleep 3600; done
fi
t "the lanes' fence is set"

# Docker reaches the Mac only now, behind the fence. -t: after one side
# ends, wait an hour for the other, not socat's 0.5 s, so `docker run -i`
# keeps its output after its input ends (S128, S129).
socat -t 3600 VSOCK-LISTEN:2375,reuseaddr,fork UNIX-CONNECT:/var/run/docker.sock &
t "docker ready"
while :; do sleep 3600; done

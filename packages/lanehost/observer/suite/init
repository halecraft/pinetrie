#!/bin/sh
# The observer suite's guest: PID 1 of a QEMU machine booted on the lane
# VM's kernel. It runs the loader as lanehost's machine role would, then
# each case as a numbered run in a lane's cgroup, and prints what the loader
# said and what the cases left between markers on the console, for
# apps/pinetrie/e2e/observer to check. It decides nothing.
export PATH=/bin
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t cgroup2 cgroup /sys/fs/cgroup
mkdir -p /w /tmp
mount -t tmpfs w /w
mount -t tmpfs tmp /tmp
mkdir -p /w/remote
# A tmpfs registered as remote stands for virtiofs: the loader lstats its files.
mount -t tmpfs remote /w/remote
E=/tmp/expect.tsv
T=$(printf '\t')
: > $E
say() { (IFS="$T"; printf '%s\n' "$*") >> $E; }
# Progress on the console, for a guest that never finishes.
step() { echo "--- $*"; }

for c in a b free; do mkdir /sys/fs/cgroup/$c; done
# A lane's first process, in its cgroup, as a container's is.
first() {
  # Its output is not the caller's: a command substitution would wait for it.
  sh -c "echo \$\$ > /sys/fs/cgroup/$1/cgroup.procs; exec sleep 100000" > /dev/null 2>&1 &
  echo $!
}
# <cgroup> <run> <command>...: the command, as run <run>, begun in <cgroup>.
inrun() {
  cg=$1 r=$2
  shift 2
  sh -c "echo \$\$ > /sys/fs/cgroup/$cg/cgroup.procs; exec env PINETRIE_RUN=$r \"\$@\"" inrun "$@" 3>&-
}
# <cgroup> <command>...: the command in <cgroup>, in no run.
outside() {
  cg=$1
  shift
  sh -c "echo \$\$ > /sys/fs/cgroup/$cg/cgroup.procs; exec \"\$@\"" outside "$@" 3>&-
}

# <ring KiB> <events file>: a loader, its commands on fd 3.
start() {
  rm -f /tmp/ctl
  mkfifo /tmp/ctl
  # Read and write, so opening it waits for no reader.
  exec 3<> /tmp/ctl
  observe "$1" < /tmp/ctl > "$2" 2> "$2.err" 3>&- &
  op=$!
  for i in $(seq 600); do
    grep -q '^ready$' "$2" 2> /dev/null && return 0
    kill -0 $op 2> /dev/null || break
    sleep 0.2
  done
  say loader-failed "$(tr '\n' ' ' < "$2.err")"
  return 1
}
stop() {
  exec 3>&-
  wait $op
}
# <line> <events file>: waits for the loader's answer.
answer() {
  for i in $(seq 600); do
    grep -q "^$1" "$2" && return 0
    sleep 0.1
  done
  say no-answer "$1"
}
flush() {
  printf 'flush\t%s\n' "$1" >&3
  answer "flushed$T$1\$" "$2"
}

PA=$(first a)
PB=$(first b)
say lane a $PA
say lane b $PB

EV=/tmp/ev.tsv
if start 65536 $EV; then
  printf 'register\t%s\t/w/remote\n' $PA >&3
  answer "registered$T$PA$T" $EV
  # Both cgroup fixtures are in the guest's one PID namespace.
  step registered

  mkdir -p /w/r1 /w/r2 /w/r34 /w/r5 /w/r6 /w/r7 /w/r10 /w/r11 /w/r13 /w/r14 /w/r16 /w/r17 /w/r22
  cd /w/r1
  inrun a 1 sh -c 'echo a > a.txt; mkdir d; mv a.txt d/b; ln -s target s; ln d/b hard; rm hard; rm d/b; rmdir d; cat missing.txt 2> /dev/null; echo x > final.txt; exit 3'
  say exit 1 $?
  say stamp $(work stamp /w/r1/final.txt)
  inrun a 18 sh -c 'kill -9 $$'
  say exit 18 $?
  cd /
  inrun a 2 sh -c '(setsid sh -c "sleep 1; echo late > /w/r2/daemon.txt" > /dev/null 2>&1 &); exit 0'
  sleep 3
  step concurrent
  inrun a 3 sh -c 'for i in $(seq 200); do echo 3 > /w/r34/p3-$i; done' &
  p3=$!
  inrun a 4 sh -c 'for i in $(seq 200); do echo 4 > /w/r34/p4-$i; done' &
  p4=$!
  wait $p3 $p4
  sleep 1
  inrun a 5 work threads /w/r5 16
  inrun a 6 env -i /bin/work threads /w/r6 2
  inrun a 7 work mmap /w/r7/m.bin
  say stamp $(work stamp /w/r7/m.bin)
  inrun a 10 work uring /w/r10/u.txt
  say exit 10 $?
  outside a sh -c 'echo u > /w/r13/untagged.txt'
  printf 'unregister\t%s\n' "$(grep "^registered$T$PA$T" $EV | cut -f3)" >&3
  inrun free 19 sh -c 'echo f > /w/r13/free.txt'
  printf 'register\t%s\t/w/remote\n' $PA >&3
  answer "registered$T$PA$T" $EV
  inrun a 14 env PINETRIE_RUN=15 sh -c 'echo n > /w/r14/n.txt'
  inrun a 16 sh -c 'echo $$ > /sys/fs/cgroup/b/cgroup.procs; echo m > /w/r16/m.txt'
  inrun a 11 unshare -Urpf sh -c 'echo ns > /w/r11/ns.txt'
  say exit 11 $?
  inrun a 20 sh -c 'echo r > /w/remote/r.txt; cat /w/remote/r.txt > /dev/null'
  say stamp $(work stamp /w/remote/r.txt)
  inrun b 21 sh -c 'echo r > /w/r21-b.txt'
  step flush
  # The loader stopped while the run writes, then sent the flush before it
  # reads on: the run's events are all still in the ring when it answers.
  kill -STOP $op
  inrun a 17 sh -c 'for i in $(seq 100); do echo $i > /w/r17/f$i; done'
  printf 'flush\tt17\n' >&3
  kill -CONT $op
  answer "flushed${T}t17\$" $EV
  CGB=$(grep "^registered$T$PA$T" $EV | tail -1 | cut -f3)
  printf 'unregister\t%s\n' "$CGB" >&3
  answer "unregistered$T$CGB\$" $EV
  inrun b 22 sh -c 'echo z > /w/r22/z.txt'
  flush end $EV
  stop
fi

# A ring far too small for four runs at once: each loss counted against its run.
FL=/tmp/flood.tsv
N=20000
if start 16 $FL; then
  printf 'register\t%s\n' $PA >&3
  answer "registered$T$PA$T" $FL
  step flood
  mkdir -p /w/flood
  echo x > /w/flood/f
  floods=""
  for r in 101 102 103 104; do
    inrun a $r work opens /w/flood/f $N &
    floods="$floods $!"
  done
  wait $floods
  sleep 1
  flush end $FL
  stop
fi
say flood $N

echo "=== events"
cat $EV
echo "=== flood"
cat $FL
echo "=== expect"
cat $E
echo "=== end"
poweroff -f

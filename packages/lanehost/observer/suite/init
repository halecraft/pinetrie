#!/bin/sh
# The observer suite's guest: PID 1 of a QEMU machine booted on the lane
# VM's kernel. It runs the loader as lanehost's machine role would, then
# each case as a numbered run in a lane's PID namespace, and prints what the
# loader said and what the cases left between markers on the console, for
# apps/pinetrie/e2e/observer to check. It decides nothing.
export PATH=/bin
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t cgroup2 cgroup /sys/fs/cgroup
mkdir -p /w /tmp
mount -t tmpfs w /w
mount -t tmpfs tmp /tmp
# bash's process substitution names its pipes here.
ln -s /proc/self/fd /dev/fd
mkdir -p /w/remote
# A tmpfs registered as remote stands for virtiofs: the loader lstats its files.
mount -t tmpfs remote /w/remote
E=/tmp/expect.tsv
T=$(printf '\t')
: > $E
say() { (IFS="$T"; printf '%s\n' "$*") >> $E; }
# Progress on the console, for a guest that never finishes.
step() { echo "--- $*"; }

# Only a run moves here: every lane stays in the root cgroup, as under a
# nested lane's rootless Docker.
mkdir /sys/fs/cgroup/moved
# <pid>: its PID namespace's inode.
nsof() { readlink /proc/$1/ns/pid | tr -dc 0-9; }
# <pid> [<level>]: its NSpid, comma-separated, or its pid at one level.
nspid() {
  v=$(grep '^NSpid:' /proc/$1/status | cut -f2- | tr '\t' ,)
  if [ -n "$2" ]; then echo "$v" | cut -d, -f$(($2 + 1)); else echo "$v"; fi
}
# [<pid>]: a lane's first process, in a PID namespace of its own (below
# <pid>'s, else the guest's), as a container's is. Prints its pid here. It
# holds no loader's commands open: the loader stops when they end.
first() {
  if [ -n "$1" ]; then
    nsenter -t "$1" -p -- unshare -p -f sleep 100000 > /dev/null 2>&1 3>&- &
  else
    unshare -p -f sleep 100000 > /dev/null 2>&1 3>&- &
  fi
  u=$!
  for i in $(seq 100); do
    c=$(cat /proc/$u/task/*/children 2> /dev/null | tr -d ' ')
    # nsenter forks unshare, which forks the first process.
    [ -n "$1" ] && [ -n "$c" ] && c=$(cat /proc/$c/task/*/children 2> /dev/null | tr -d ' ')
    [ -n "$c" ] && break
    sleep 0.05
  done
  echo $c
}
# <first pid> <run> <command>...: the command, as run <run>, begun in that lane.
inrun() {
  f=$1 r=$2
  shift 2
  nsenter -t $f -p -- env PINETRIE_RUN=$r "$@" 3>&-
}
# <first pid> <command>...: the command in that lane, in no run.
outside() {
  f=$1
  shift
  nsenter -t $f -p -- "$@" 3>&-
}

# <first pid> <run> <shell> <command file>: the shell on the command, as
# run <run>, begun in that lane as a helper's `shell` call is: stdin
# /dev/null, stdout and stderr each a pipe of its own, read to their ends
# into /tmp/out<run>.1 and .2.
piperun() {
  f=$1 r=$2 sh=$3
  rm -f /tmp/p$r.1 /tmp/p$r.2
  mkfifo /tmp/p$r.1 /tmp/p$r.2
  cat /tmp/p$r.1 > /tmp/out$r.1 &
  c1=$!
  cat /tmp/p$r.2 > /tmp/out$r.2 &
  c2=$!
  nsenter -t $f -p -- env PINETRIE_RUN=$r $sh -c "$(cat $4)" < /dev/null > /tmp/p$r.1 2> /tmp/p$r.2 3>&-
  wait $c1 $c2
}
# <run>: what its pipes carried, in hex, for the scenario to attribute.
sayout() {
  say bytes $1 1 "$(od -An -v -tx1 /tmp/out$1.1 | tr -d ' \n')"
  say bytes $1 2 "$(od -An -v -tx1 /tmp/out$1.2 | tr -d ' \n')"
}

# <ring KiB> <events file> [<output ring KiB>]: a loader, its commands on fd 3.
start() {
  rm -f /tmp/ctl
  mkfifo /tmp/ctl
  # Read and write, so opening it waits for no reader.
  exec 3<> /tmp/ctl
  observe "$1" $3 < /tmp/ctl > "$2" 2> "$2.err" 3>&- &
  op=$!
  for i in $(seq 600); do
    grep -q '^ready$' "$2" 2> /dev/null && return 0
    kill -0 $op 2> /dev/null || break
    sleep 0.2
  done
  say loader-failed "$(tr '\n' ' ' < "$2.err")"
  return 1
}
stop() {
  exec 3>&-
  wait $op
}
# <line> <events file>: waits for the loader's answer.
answer() {
  for i in $(seq 600); do
    grep -q "^$1" "$2" && return 0
    sleep 0.1
  done
  say no-answer "$1"
  step "no answer: $1"
}
flush() {
  printf 'flush\t%s\n' "$1" >&3
  answer "flushed$T$1\$" "$2"
}
# <events file> <token> <pid> [<remote dir>]: the lane whose first process is
# <pid> registered, as the machine role registers a direct host's.
register() {
  printf 'open\t%s\t%s\n' $2 $3 >&3
  answer "looked$T$2$T" $1
  printf 'install\t%s\t%s%s\n' $2 $3 "${4:+$T$4}" >&3
  answer "registered$T$2$T" $1
}
# <events file> <token>: the lane token registered.
laneof() { grep "^registered$T$2$T" $1 | cut -f3; }

PA=$(first)
PB=$(first)
PF=$(first)
say lane a $PA $(nsof $PA)
say lane b $PB $(nsof $PB)

EV=/tmp/ev.tsv
if start 65536 $EV; then
  register $EV a $PA /w/remote
  register $EV b $PB
  step registered

  # A namespace held registered keeps its number after its processes exit;
  # let go, the kernel gives the number to the next namespace made.
  PP=$(first)
  register $EV p $PP
  NP=$(nsof $PP)
  kill -9 $PP
  while kill -0 $PP 2> /dev/null; do sleep 0.05; done
  sleep 1
  PQ=$(first)
  NQ=$(nsof $PQ)
  printf 'unregister\t%s\n' $NP >&3
  answer "unregistered$T$NP\$" $EV
  sleep 1
  PR=$(first)
  say pin $NP $NQ $(nsof $PR)
  kill -9 $PQ $PR

  mkdir -p /w/r1 /w/r2 /w/r34 /w/r5 /w/r6 /w/r7 /w/r10 /w/r11 /w/r13 /w/r14 /w/r16 /w/r17 /w/r22 /w/r23
  cd /w/r1
  inrun $PA 1 sh -c 'echo a > a.txt; mkdir d; mv a.txt d/b; ln -s target s; ln d/b hard; rm hard; rm d/b; rmdir d; cat missing.txt 2> /dev/null; echo x > final.txt; exit 3'
  say exit 1 $?
  say stamp $(work stamp /w/r1/final.txt)
  inrun $PA 18 sh -c 'kill -9 $$'
  say exit 18 $?
  cd /
  inrun $PA 2 sh -c '(setsid sh -c "sleep 1; echo late > /w/r2/daemon.txt" > /dev/null 2>&1 &); exit 0'
  sleep 3
  step concurrent
  inrun $PA 3 sh -c 'for i in $(seq 200); do echo 3 > /w/r34/p3-$i; done' &
  p3=$!
  inrun $PA 4 sh -c 'for i in $(seq 200); do echo 4 > /w/r34/p4-$i; done' &
  p4=$!
  wait $p3 $p4
  sleep 1
  inrun $PA 5 work threads /w/r5 16
  inrun $PA 6 env -i /bin/work threads /w/r6 2
  inrun $PA 7 work mmap /w/r7/m.bin
  say stamp $(work stamp /w/r7/m.bin)
  inrun $PA 10 work uring /w/r10/u.txt
  say exit 10 $?
  outside $PA sh -c 'echo u > /w/r13/untagged.txt'
  inrun $PF 19 sh -c 'echo f > /w/r13/free.txt'
  inrun $PA 14 env PINETRIE_RUN=15 sh -c 'echo n > /w/r14/n.txt'
  inrun $PA 16 sh -c 'echo $$ > /sys/fs/cgroup/moved/cgroup.procs; echo m > /w/r16/m.txt'
  inrun $PA 11 unshare -Urpf sh -c 'echo ns > /w/r11/ns.txt'
  say exit 11 $?
  inrun $PA 20 sh -c 'echo r > /w/remote/r.txt; cat /w/remote/r.txt > /dev/null'
  say stamp $(work stamp /w/remote/r.txt)
  inrun $PB 21 sh -c 'echo r > /w/r21-b.txt'

  step nested
  # A lane inside lane a, found as a forwarded registration is: by its pid
  # in a's namespace, at a's level, every candidate's parents read.
  PI=$(first $PA)
  say inner $PI $(nspid $PI) $(nsof $PI) $(nsof $PA) $(nsof 1)
  printf 'find\tn\t1\t%s\n' $(nspid $PI 1) >&3
  answer "looked${T}n$T" $EV
  printf 'install\tn\t%s\n' $PI >&3
  answer "registered${T}n$T" $EV
  inrun $PI 23 sh -c 'echo i > /w/r23/i.txt'
  inrun $PA 24 sh -c 'echo o > /w/r23/o.txt'

  step bash
  # Every kind of statement, in pine·trie's bash (/cmd.sh, from the scenario).
  printf 'echo "$1"\n' > /tmp/src.sh
  mkdir -p /w/r30
  cd /w/r30
  piperun $PA 30 /bin/bash-pt /cmd.sh
  cd /
  sayout 30
  # busybox's sh never signals: its run's pipes are never learned.
  printf 'echo x; echo y >&2' > /tmp/plain.sh
  piperun $PA 31 sh /tmp/plain.sh
  printf 'stats\ts30\n' >&3
  answer "stats-done${T}s30\$" $EV
  # The loader stopped while a call writes, then sent the flush before it
  # reads on: the call's output is in its rings when it answers.
  printf 'echo a; echo b >&2' > /tmp/settle.sh
  kill -STOP $op
  piperun $PA 32 /bin/bash-pt /tmp/settle.sh
  printf 'flush\tt32\n' >&3
  kill -CONT $op
  answer "flushed${T}t32\$" $EV
  sayout 32

  step flush
  # The loader stopped while the run writes, then sent the flush before it
  # reads on: the run's events are all still in the ring when it answers.
  kill -STOP $op
  inrun $PA 17 sh -c 'for i in $(seq 100); do echo $i > /w/r17/f$i; done'
  printf 'flush\tt17\n' >&3
  kill -CONT $op
  answer "flushed${T}t17\$" $EV
  NA=$(laneof $EV a)
  printf 'unregister\t%s\n' $NA >&3
  answer "unregistered$T$NA\$" $EV
  inrun $PA 22 sh -c 'echo z > /w/r22/z.txt'
  flush end $EV
  stop
fi

# A ring far too small for four runs at once: each loss counted against its run.
FL=/tmp/flood.tsv
N=20000
if start 16 $FL; then
  register $FL a $PA
  step flood
  mkdir -p /w/flood
  echo x > /w/flood/f
  floods=""
  for r in 101 102 103 104; do
    inrun $PA $r work opens /w/flood/f $N &
    floods="$floods $!"
  done
  wait $floods
  sleep 1
  flush end $FL
  stop
fi
say flood $N

# An output ring far too small for a call's output, read by a loader stopped
# meanwhile: its output is lost, counted, and none of its file events, though
# the disk ring has room for its file events only, not its output's.
OF=/tmp/oflood.tsv
if start 256 $OF 16; then
  register $OF a $PA
  step oflood
  mkdir -p /w/oflood
  printf 'for i in $(seq 50); do head -c 2097152 /dev/zero; echo x > /w/oflood/f$i; done' > /tmp/oflood.sh
  kill -STOP $op
  piperun $PA 40 /bin/bash-pt /tmp/oflood.sh
  kill -CONT $op
  flush end $OF
  stop
fi

echo "=== events"
cat $EV
echo "=== flood"
cat $FL
echo "=== oflood"
cat $OF
echo "=== expect"
cat $E
echo "=== end"
poweroff -f

# S304's guest, as S298's: the driver (with attr.bpf.c in its skeleton) and forge,
# static; pine·trie's bash (bash.patch, static, musl) as /bin/bash-pt;
# Alpine's stock bash as /bin/bash; busybox; the commands guest.py wrote.
# vmlinux.btf is the lane VM kernel's BTF.
FROM docker.io/library/alpine:3.23 AS bash
RUN apk add --no-cache build-base curl patch
WORKDIR /src
RUN curl -sfL https://ftp.gnu.org/gnu/bash/bash-5.2.37.tar.gz | tar xz
COPY bash.patch /src/
# bash 5.2's old-style C needs C17 under gcc 15.
RUN cd bash-5.2.37 && patch -p1 < ../bash.patch \
 && CFLAGS="-O2 -std=gnu17 -Wno-error=implicit-function-declaration" ./configure --enable-static-link --without-bash-malloc --quiet \
 && make -s -j4 > /tmp/make.log 2>&1 || (tail -40 /tmp/make.log; exit 1)

FROM docker.io/library/alpine:3.23
RUN apk add --no-cache clang llvm libbpf-dev bpftool elfutils-dev zlib-static zstd-static zstd-dev linux-headers build-base busybox-static cpio bash
COPY vmlinux.btf attr.h attr.bpf.c drive.c forge.c init cmd.sh cmd-trap.sh /src/
WORKDIR /src
RUN bpftool btf dump file vmlinux.btf format c > vmlinux.h \
 && clang -O2 -g -Wall -target bpf -D__TARGET_ARCH_arm64 -I. -c attr.bpf.c -o attr.bpf.o \
 && bpftool gen skeleton attr.bpf.o name attr_bpf > attr.skel.h \
 && cc -O2 -Wall -static -I. -o drive drive.c -lbpf -lelf -lz -lzstd -lpthread \
 && cc -O2 -Wall -static -I. -o forge forge.c
COPY --from=bash /src/bash-5.2.37/bash /src/bash-pt
RUN mkdir -p /guest/bin /guest/usr/lib /guest/lib /guest/proc /guest/sys /guest/dev /guest/tmp \
 && cp /bin/busybox.static /guest/bin/busybox \
 && for a in $(/bin/busybox.static --list); do ln -sf busybox /guest/bin/$a; done \
 && cp /bin/bash /guest/bin/bash && cp bash-pt /guest/bin/bash-pt \
 && cp /lib/ld-musl-aarch64.so.1 /guest/lib/ \
 && cp /usr/lib/libreadline.so.8 /usr/lib/libncursesw.so.6 /guest/usr/lib/ \
 && cp drive forge /guest/bin/ && cp cmd.sh cmd-trap.sh /guest/ \
 && cp init /guest/init && chmod 755 /guest/init \
 && (cd /guest && find . | cpio -o -H newc --quiet | gzip -1) > /initramfs.cpio.gz

#!/bin/sh
# S304's guest: PID 1 on the lane VM's kernel. Runs the patched bash on the
# command with stdout and stderr on pipes of their own, prints what the
# driver printed between markers, and powers off.
export PATH=/bin:/usr/bin
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs tmp /tmp
ln -s /proc/self/fd /dev/fd
printf 'echo "$1"\n' > /tmp/src.sh
echo "=== run main"
timeout 300 drive /bin/bash-pt /cmd.sh 2>&1
echo "=== end"
poweroff -f

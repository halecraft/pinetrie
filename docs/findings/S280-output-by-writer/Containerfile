# S280's guest: the driver (with attr.bpf.c in its skeleton), static, and an
# initramfs of busybox around it. vmlinux.btf is the lane VM kernel's BTF.
FROM docker.io/library/alpine:3.23
RUN apk add --no-cache clang llvm libbpf-dev bpftool elfutils-dev zlib-static zstd-static zstd-dev linux-headers build-base busybox-static liburing-dev cpio
COPY vmlinux.btf attr.h attr.bpf.c drive.c init /src/
WORKDIR /src
RUN bpftool btf dump file vmlinux.btf format c > vmlinux.h \
 && for v in drive:  drive-naive:-DNAIVE drive-noclean:-DNOCLEAN; do \
      name=${v%%:*}; flag=${v#*:}; \
      clang -O2 -g -Wall -target bpf -D__TARGET_ARCH_arm64 $flag -I. -c attr.bpf.c -o attr.bpf.o \
      && bpftool gen skeleton attr.bpf.o name attr_bpf > attr.skel.h \
      && cc -O2 -Wall -static -I. -o $name drive.c -lbpf -lelf -lz -lzstd -luring -lpthread || exit 1; \
    done
RUN mkdir -p /guest/bin /guest/proc /guest/sys /guest/dev /guest/tmp \
 && cp /bin/busybox.static /guest/bin/busybox \
 && for a in $(/bin/busybox.static --list); do ln -sf busybox /guest/bin/$a; done \
 && cp drive drive-naive drive-noclean /guest/bin/ && cp init /guest/init && chmod 755 /guest/init \
 && (cd /guest && find . | cpio -o -H newc --quiet | gzip -1) > /initramfs.cpio.gz

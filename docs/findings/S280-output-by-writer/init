#!/bin/sh
# S280's guest: PID 1 on the lane VM's kernel. Runs the driver three times and each control once, prints
# what it measured between markers, and powers off.
export PATH=/bin
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs tmp /tmp
# A small pid space, so the untagged writers reuse the tids of exited tagged ones.
echo 400 > /proc/sys/kernel/pid_max
for d in drive drive drive drive-naive drive-noclean; do
  echo "=== $d"
  $d 2>&1 | grep -v '^step\|done$'
done
echo "=== end"
poweroff -f

# S300: pine·trie's bash (5.3, GNU's patches 001-020, apply.py), static
# against musl, with mimalloc linked in as its allocator: its object file,
# linked first, defines malloc and the rest, so musl's are never pulled in.
FROM docker.io/library/alpine:3.23
ARG MIMALLOC=v2.2.4
RUN apk add --no-cache build-base curl python3 patch cmake > /dev/null
WORKDIR /src
RUN curl -sfL https://github.com/microsoft/mimalloc/archive/refs/tags/${MIMALLOC}.tar.gz | tar xz \
 && cmake -S mimalloc-* -B mi -DMI_BUILD_OBJECT=ON -DMI_BUILD_SHARED=OFF -DMI_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release > /dev/null \
 && cmake --build mi --target mimalloc-obj-target -j4 > /dev/null \
 && cp "$(find mi -name mimalloc.o -o -name static.c.o | head -1)" /src/mimalloc.o && ls -la /src/mimalloc.o
RUN curl -sfL https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz | tar xz \
 && for i in $(seq -w 1 20); do curl -sfL https://ftp.gnu.org/gnu/bash/bash-5.3-patches/bash53-0$i | patch -s -p0 -d bash-5.3 || exit 1; done
COPY apply.py /src/
RUN python3 apply.py bash-5.3 && cd bash-5.3 \
 && ./configure --enable-static-link --without-bash-malloc --quiet \
 && (make -s -j4 LOCAL_LIBS=/src/mimalloc.o > /tmp/make.log 2>&1 || (tail -25 /tmp/make.log; exit 1)) \
 && cp bash /bash-pt && /bash-pt -c 'echo "built $BASH_VERSION"'

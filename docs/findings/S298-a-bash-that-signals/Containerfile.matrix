# S298: pine·trie's bash at version V, patched by apply.py, static, against
# the C library of BASE (Alpine: musl; Debian: glibc).
#   docker build --build-arg BASE=… --build-arg V=5.3 -f Containerfile.matrix .
ARG BASE=docker.io/library/alpine:3.23
FROM ${BASE}
ARG V
RUN if command -v apk >/dev/null; then apk add --no-cache build-base curl python3 > /dev/null; \
    else apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq build-essential curl python3 > /dev/null; fi
WORKDIR /src
RUN curl -sfL https://ftp.gnu.org/gnu/bash/bash-${V}.tar.gz | tar xz
COPY apply.py /src/
# bash before 5.3 is old-style C, which gcc 14 and later reject by default.
RUN python3 apply.py bash-${V} && cd bash-${V} \
 && CFLAGS="-O2 -std=gnu17 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types" ./configure --enable-static-link --without-bash-malloc --quiet \
 && (make -s -j4 > /tmp/make.log 2>&1 || (grep -m5 "error" /tmp/make.log; exit 1)) \
 && cp bash /bash-pt && /bash-pt -c 'echo "built $BASH_VERSION"'

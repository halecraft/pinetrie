{
  "name": "pinetrie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collaborative agentic harness — pi's agent core on Kyneta's CRDT substrate.",
  "scripts": {
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "pnpm --filter @pinetrie/conformance run conformance",
    "dev": "pnpm --filter @pinetrie/app run dev",
    "dev:react": "pnpm --filter @pinetrie/app run dev:react",
    "serve": "pnpm --filter @pinetrie/app run serve",
    "sign-in": "pnpm --filter @pinetrie/app run sign-in",
    "sign-out": "pnpm --filter @pinetrie/app run sign-out",
    "session": "pnpm --filter @pinetrie/app run session",
    "tidy": "pnpm --filter @pinetrie/app run tidy",
    "e2e": "pnpm --filter @pinetrie/app run e2e",
    "e2e:live": "pnpm --filter @pinetrie/app run e2e:live",
    "e2e:browser": "pnpm --filter @pinetrie/app run e2e:browser",
    "e2e:lanes": "pnpm --filter @pinetrie/app run e2e:lanes",
    "e2e:observer": "pnpm --filter @pinetrie/app run e2e:observer",
    "vm:build": "pnpm --filter @pinetrie/app run vm:build",
    "build": "pnpm --filter @pinetrie/app run build",
    "package": "node scripts/package.ts && cd dist && npm pack ./pinetrie",
    "publish:npm": "pnpm run package && cd dist && npm publish \"pinetrie-$(node -p \"require('../package.json').version\").tgz\"",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run proofs:unit && pnpm run conformance && pnpm run e2e && pnpm run e2e:lanes",
    "verify:all": "pnpm run verify && pnpm run e2e:live && pnpm run e2e:browser",
    "mutate": "node scripts/mutate.ts",
    "proofs:unit": "node scripts/unit-proofs.ts",
    "indexes": "node scripts/indexes.ts",
    "record": "node scripts/record.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "oxc-parser": "0.154.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "packageManager": "pnpm@10.18.0"
}

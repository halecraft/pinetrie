{
  "name": "pineta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Collaborative agentic harness \u2014 pi's agent core on Kyneta's CRDT substrate. Walking skeleton.",
  "scripts": {
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "pnpm --filter @pineta/conformance run conformance",
    "host": "pnpm --filter @pineta/app run host",
    "e2e": "pnpm --filter @pineta/app run e2e",
    "e2e:live": "pnpm --filter @pineta/app run e2e:live",
    "e2e:browser": "pnpm --filter @pineta/app run e2e:browser",
    "build": "pnpm --filter @pineta/client run build",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run conformance && pnpm run e2e",
    "verify:all": "pnpm run verify && pnpm run e2e:live && pnpm run e2e:browser",
    "mutate": "node scripts/mutate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.56.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.18.0"
}

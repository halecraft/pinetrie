{
  "name": "pineta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Collaborative agentic harness \u2014 pi's agent core on Kyneta's CRDT substrate. Walking skeleton.",
  "scripts": {
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check": "node scripts/check-boundaries.ts",
    "sanity": "node scripts/sanity.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "pnpm --filter @pineta/conformance run conformance",
    "host": "node host/server.ts",
    "e2e": "node e2e/e2e.ts",
    "e2e:live": "PINETA_LIVE=1 node e2e/e2e.ts",
    "e2e:browser": "node e2e/browser.ts",
    "verify": "pnpm run lint && pnpm run check && pnpm run sanity && pnpm test && pnpm run conformance && pnpm run e2e",
    "verify:all": "pnpm run verify && pnpm run e2e:live && pnpm run e2e:browser",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "//dependencies": "@kyneta/changefeed, @kyneta/reactive, @kyneta/machine and @kyneta/transport are never imported here. They are PEER dependencies of @kyneta/react and @kyneta/websocket-transport, and pnpm's strict tree requires them declared. Removing them because nothing imports them will break the browser client at resolution time.",
  "dependencies": {
    "@kyneta/changefeed": "link:../kyneta/packages/changefeed",
    "@kyneta/exchange": "link:../kyneta/packages/exchange",
    "@kyneta/loro-schema": "link:../kyneta/packages/schema/backends/loro",
    "@kyneta/machine": "link:../kyneta/packages/machine",
    "@kyneta/react": "link:../kyneta/packages/react",
    "@kyneta/reactive": "link:../kyneta/packages/reactive",
    "@kyneta/schema": "link:../kyneta/packages/schema",
    "@kyneta/transport": "link:../kyneta/packages/transport",
    "@kyneta/websocket-transport": "link:../kyneta/packages/exchange/transports/websocket",
    "@pineta/core": "workspace:*",
    "@pineta/pi": "workspace:*",
    "@pineta/schema": "workspace:*",
    "loro-crdt": "^1.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.56.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "vite-plugin-wasm": "3.5.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.18.0"
}

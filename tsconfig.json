{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "jsx": "react-jsx",
    "noEmit": true,

    // Node 24 strips types natively, so we run .ts directly and imports must
    // name the real file. `allowImportingTsExtensions` makes tsc agree.
    "allowImportingTsExtensions": true,

    // TypeScript 6 stopped including every `@types` package by default; this
    // keeps Node's globals in every config that extends this one, as before.
    "types": ["node"],

    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["apps", "packages", "scripts", "workspace.test.ts"],
  "exclude": ["node_modules", "sandbox"]
}

{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "root": ".",
    "enabled": true,
    "clientKind": "git"
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.pnpm-store",
      "!!sandbox",
      "!!.pineta",
      "!!.plans"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 80,
    "indentWidth": 2,
    "indentStyle": "space",
    "formatWithErrors": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "enabled": true,
      "bracketSpacing": true,
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "arrowParentheses": "asNeeded",
      "indentStyle": "space"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/**",
        "packages/client/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!packages/core/fixtures.ts",
        "!packages/core/trailers.ts",
        "!packages/client/fixtures.ts",
        "!apps/pineta/host/fakes.ts",
        "!packages/client/layout.ts",
        "!packages/client/left.ts",
        "!packages/client/use-ask-bar.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@pineta/core": {
                    "importNames": ["entryId", "runId"],
                    "message": "Mint an id only where it enters: here it arrives branded from a read (packages/core/index.ts)."
                  },
                  "./index.ts": {
                    "importNames": ["entryId", "runId"],
                    "message": "Mint an id only where it enters: here it arrives branded from a read (packages/core/index.ts)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/pineta/host/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!packages/core/fixtures.ts",
        "!packages/client/fixtures.ts",
        "!apps/pineta/host/fakes.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@pineta/core": {
                    "importNames": ["entryId"],
                    "message": "Mint an id only where it enters: here it arrives branded from a read (packages/core/index.ts)."
                  },
                  "./index.ts": {
                    "importNames": ["entryId"],
                    "message": "Mint an id only where it enters: here it arrives branded from a read (packages/core/index.ts)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
